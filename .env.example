# Copy to .env / .env.local — never commit real keys.
# After editing env files, restart the Next.js server.
#
# Netlify (pitchline-app) site env — set in Netlify UI / CLI (no secrets in git):
#   DATABASE_URL, AUTH_SECRET, API_FOOTBALL_KEY, GEMINI_API_KEY, PITCHLINE_PLAN
#
# Prisma provider is postgresql (required for Netlify serverless).
# SQLite file DBs will not work on Netlify.
# Local Air: point DATABASE_URL at Postgres (Neon free tier, Netlify DB, or local Docker).
# Temporary SQLite-only local work: see prisma/schema.sqlite.prisma (not used by default).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional integrations (app degrades gracefully when empty)
API_FOOTBALL_KEY=
GEMINI_API_KEY=
# Used by Packs and match News (grounded web brief) — Intel plan also required
# Optional Gemini model override
# GEMINI_MODEL=gemini-2.0-flash

# AI lab gate (NOT a paid tier): base (default) | intel
# Commercial SKU is Unlimited £22 — see /pricing. Gemini key alone does NOT unlock Auto Gen.
PITCHLINE_PLAN=base

# Optional: cron bearer for /api/cron/* (falls back to AUTH_SECRET)
# CRON_SECRET=

# Commercial: choose-at-start Unlimited (£22/mo after 14d trial) OR Match Desk Pass packs
# Secret key: paste from Stripe Dashboard → Developers → API keys (never commit).
# STRIPE_SECRET_KEY=sk_live_...   # or sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# Livemode price ids (already created):
# STRIPE_PRICE_UNLIMITED=price_1UEqHNDxFzIII5bI65Xe2X2k   # Unlimited £22/mo · prod_VFKxfpNuGj4rl8
# STRIPE_PRICE_PASS_1=price_1UEqHxDxFzIII5bIREWbhi3G       # Match Pass 1 · £8
# STRIPE_PRICE_PASS_5=price_1UEqHyDxFzIII5bI10zezbCw       # Match Pass 5 · £25
# STRIPE_PRICE_PASS_10=price_1UEqHzDxFzIII5bIOotem2LF      # Match Pass 10 · £30
# STRIPE_WEBHOOK_SECRET=whsec_...   # Dashboard → Webhooks → endpoint secret
# NEXT_PUBLIC_APP_URL=https://www.cocomms.online

# Optional: U&R Show board handoff webhook (Remote football comms desk)
# UR_HANDOFF_WEBHOOK_URL=
