# Copy to .env / .env.local — never commit real keys.
# After editing env files, restart the Next.js server.
# Exact key names: API_FOOTBALL_KEY, GEMINI_API_KEY, PITCHLINE_PLAN
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me"

# Optional integrations (app degrades gracefully when empty)
API_FOOTBALL_KEY=
GEMINI_API_KEY=
# Used by Packs and match News (grounded web brief) — Intel plan also required
# Optional Gemini model override
# GEMINI_MODEL=gemini-2.0-flash

# Plan entitlements: base (default) | intel
# Gemini key alone does NOT enable Auto Gen / brief / note-draft on base
PITCHLINE_PLAN=base
