generator client {
  provider      = "prisma-client-js"
  // native = local Mac/Linux; rhel-openssl-3.0.x = Netlify serverless (Node 18+)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String
  name                 String
  role                 String     @default("commentator")
  avatarInitials       String     @default("PL")
  theme                String     @default("system")
  /// none | trial | active | cancelled | expired
  billingStatus        String     @default("none")
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  trialCancelledAt     DateTime?
  /// App-side: do not convert to paid at trial end. Stripe cancel uses Customer Portal.
  cancelAtPeriodEnd    Boolean    @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// One-time Match Desk Pass credits (1 desk per credit). Demo accounts ignore caps.
  matchPassCredits     Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  matchDays            MatchDay[]
  notes                Note[]
  speaks               Speak[]
}

model Club {
  id               String          @id @default(cuid())
  name             String
  shortName        String
  abbreviation     String
  primaryColor     String
  secondaryColor   String
  founded          Int?
  city             String?
  stadiumName      String?
  nickname         String?
  fansApprox       Int?
  badgeEmoji       String          @default("⚽")
  apiFootballTeamId Int?
  players          Player[]
  coaches          Coach[]
  homeMatches      Match[]         @relation("HomeClub")
  awayMatches      Match[]         @relation("AwayClub")
  injuries         Injury[]
  scorers          SeasonScorer[]
  keepers          SeasonKeeper[]
  penalties        PenaltyRecord[]
}

model Player {
  id               String          @id @default(cuid())
  clubId           String
  club             Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name             String
  shirtNumber      Int
  position         String
  nationality      String          @default("UNK")
  age              Int?
  heightCm         Int?
  preferredFoot    String?
  photoUrl         String?
  weightKg         Int?
  birthDate        String?
  birthCountry     String?
  isCaptain        Boolean         @default(false)
  isStarter        Boolean         @default(false)
  formationSlot    String?
  onPitch          Boolean         @default(false)
  apiFootballPlayerId Int?
  goals            Int             @default(0)
  assists          Int             @default(0)
  goalsAllComps    Int             @default(0)
  assistsAllComps  Int             @default(0)
  appearances      Int             @default(0)
  cleanSheets      Int             @default(0)
  yellowCards      Int             @default(0)
  redCards         Int             @default(0)
  rating           Float?
  injuries         Injury[]
  events           MatchEvent[]
  scorers          SeasonScorer[]
  keepers          SeasonKeeper[]
  penalties        PenaltyRecord[]
  matchOverrides   MatchPlayerOverride[]
}

model Coach {
  id          String  @id @default(cuid())
  clubId      String
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  nationality String  @default("UNK")
  age         Int?
  role        String  @default("Head Coach")
  photoUrl    String?
  apiFootballCoachId Int?
}

model Official {
  id          String          @id @default(cuid())
  name        String
  role        String
  nationality String          @default("ENG")
  age         Int?
  matches     MatchOfficial[]
}

model Venue {
  id               String  @id @default(cuid())
  name             String
  city             String
  capacity         Int
  surface          String  @default("Grass")
  opened           Int?
  address          String?
  pitchLength      Int?    @default(105)
  pitchWidth       Int?    @default(68)
  notes            String?
  lat              Float?
  lon              Float?
  imageUrl         String?
  apiFootballVenueId Int?
  matches          Match[]
}

model MatchDay {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  competition String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("upcoming")
  matches     Match[]
  /// U&R Show board (1:1) — claim creates this; Remote football comms desk consumes handoff
  urShow      UrShow?
  createdAt   DateTime @default(now())
}

model Match {
  id                   String          @id @default(cuid())
  matchDayId           String
  matchDay             MatchDay        @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  homeClubId           String
  awayClubId           String
  homeClub             Club            @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub             Club            @relation("AwayClub", fields: [awayClubId], references: [id])
  venueId              String?
  venue                Venue?          @relation(fields: [venueId], references: [id])
  kickoff              DateTime
  status               String          @default("Assigned")
  homeScore            Int             @default(0)
  awayScore            Int             @default(0)
  homeFormation        String          @default("4-3-3")
  awayFormation        String          @default("4-2-3-1")
  minute               Int             @default(0)
  minuteExtra          Int?
  period               String          @default("pre")
  weatherSummary       String?
  weatherTempC         Float?
  weatherWindKph       Float?
  weatherHumidity      Int?
  attendance           Int?
  featured             Boolean         @default(false)
  apiFootballFixtureId Int?
  lineupStatus         String          @default("expected")
  lastFeedSyncAt       DateTime?
  preKickoffHardSyncAt DateTime?
  /// Per-match strip colours from feed lineups (JSON); empty string = checked none.
  homeKitJson          String?
  awayKitJson          String?
  predictionsAdvice    String?
  predictionsJson      String?
  h2hSummary           String?
  predictedHomeJson    String?
  predictedAwayJson    String?
  lineupPackGeneratedAt DateTime?
  lineupPackXiHash     String?
  notes                Note[]
  speaks               Speak[]
  checklistItems       ChecklistItem[]
  events               MatchEvent[]
  officials            MatchOfficial[]
  injuries             Injury[]
  statistics           Statistic[]
  packSections         PackSection[]
  playerOverrides      MatchPlayerOverride[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model MatchOfficial {
  id         String   @id @default(cuid())
  matchId    String
  officialId String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  official   Official @relation(fields: [officialId], references: [id], onDelete: Cascade)
  role       String
}

model Note {
  id         String   @id @default(cuid())
  matchId    String?
  match      Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  title      String
  body       String
  category   String   @default("Custom")
  entityType String?
  entityId   String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Speak {
  id        String   @id @default(cuid())
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  body      String
  timing    String   @default("pre-match")
  order     Int      @default(0)
  /// generated | edited — user edits set edited; distribute skips overwrite
  status    String   @default("generated")
  createdAt DateTime @default(now())
}

model ChecklistItem {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  label     String
  category  String  @default("prep")
  done      Boolean @default(false)
  order     Int     @default(0)
}

model MatchEvent {
  id               String   @id @default(cuid())
  matchId          String
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId         String?
  player           Player?  @relation(fields: [playerId], references: [id])
  type             String
  minute           Int
  teamSide         String?
  description      String
  commentary       String?
  apiFootballEventId Int?
  createdAt        DateTime @default(now())
}

model Injury {
  id             String  @id @default(cuid())
  matchId        String?
  match          Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clubId         String
  club           Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status         String  @default("doubtful")
  injuryType     String
  expectedReturn String?
  notes          String?
}

model Statistic {
  id        String @id @default(cuid())
  matchId   String
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  label     String
  homeValue String
  awayValue String
  order     Int    @default(0)
}

model SeasonScorer {
  id       String @id @default(cuid())
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  goals    Int
  assists  Int    @default(0)
  rank     Int
}

model SeasonKeeper {
  id          String @id @default(cuid())
  clubId      String
  club        Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cleanSheets Int
  saves       Int    @default(0)
  appearances Int    @default(0)
  rank        Int
}

model PenaltyRecord {
  id         String  @id @default(cuid())
  clubId     String
  club       Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId   String?
  player     Player? @relation(fields: [playerId], references: [id])
  takerName  String
  scored     Int     @default(0)
  missed     Int     @default(0)
  saved      Int     @default(0)
  preference String  @default("right")
  notes      String?
}

model PackTemplate {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String?
  section     String
  prompt      String
  order       Int    @default(0)
}

model PackSection {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  templateKey String
  title       String
  content     String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([matchId, templateKey])
}

model MatchPlayerOverride {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  displayName   String?
  pronunciation String?
  /// primary | secondary | both | or a nationality label
  pitchFlag     String?
  jerseyNumber  Int?
  /// Manual pitch placement — survives AF sync until Reset official
  formationSlot String?
  /// Free-move landscape coords (0–100). When set, overrides slot snap geometry.
  pitchX        Float?
  pitchY        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}

/// U&R (Up & Running) Show board — one per claimed MatchDay on the personal account.
/// Remote football comms desk owns Restream/creatives/OBS after handoff.
model UrShow {
  id                    String   @id @default(cuid())
  matchDayId            String   @unique
  matchDay              MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  /// Same as MatchDay.userId at claim time (tenancy = session.userId)
  claimedByUserId       String
  /// Planned → Creatives → Bound → Soundcheck → Live → Done
  status                String   @default("Planned")
  youtubeWatchUrl       String?
  restreamExternalUrl   String?
  /// Board JSON: ytTitle / ytDescription (Remote desk promo copy)
  ytTitle               String?
  ytDescription         String?
  /// IG We're Live still — Canva DAHU_M_olhE
  igStillUrl            String?
  /// Placeholder encoder event id — real Restream API TODO when keys exist
  restreamEventStubId   String?
  /// Placeholder upcoming YT (unlisted until promo approved) — real YT API TODO
  youtubeUpcomingStubId String?
  handoffReadyAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creatives             UrCreative[]
  socialSlots           UrSocialSlot[]
  handoffLogs           UrHandoffLog[]

  @@index([claimedByUserId])
}

model UrCreative {
  id         String   @id @default(cuid())
  urShowId   String
  urShow     UrShow   @relation(fields: [urShowId], references: [id], onDelete: Cascade)
  /// thumb | cover | open | ht | ft
  kind       String
  label      String
  canvaId    String?
  /// Short Canva share / design link from Remote desk
  canvaUrl   String?
  /// Hook for Remote desk Canva / CDN asset URL (preview or final)
  assetUrl   String?
  /// pending | approved | rejected
  status     String   @default("pending")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([urShowId])
}

model UrSocialSlot {
  id          String    @id @default(cuid())
  urShowId    String
  urShow      UrShow    @relation(fields: [urShowId], references: [id], onDelete: Cascade)
  /// t_day | t_1h | were_live | ft
  slotKey     String
  label       String
  /// youtube | facebook | instagram | x
  platform    String    @default("youtube")
  copy        String    @default("")
  assetUrl    String?
  approved    Boolean   @default(false)
  scheduledAt DateTime?
  /// draft | scheduled | posted
  status      String    @default("draft")
  creativeKind String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([urShowId, slotKey])
  @@index([urShowId])
}

model UrHandoffLog {
  id          String   @id @default(cuid())
  urShowId    String
  urShow      UrShow   @relation(fields: [urShowId], references: [id], onDelete: Cascade)
  message     String
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([urShowId])
}
